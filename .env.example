# JALAMAP V3 — Configuration File
# Copy to .env.local to enable real Supabase synchronization.
# If omitted, JALAMAP runs seamlessly in deterministic local offline simulation mode.

VITE_SUPABASE_URL=https://your-project.supabase.co
